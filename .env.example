# LLM API Configuration
# Default & Recommended: Google Gemini (supports generous free tier)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model selection (e.g., gemini-2.5-flash, gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional alternative providers
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Dataset path (relative to project root)
DATASET_PATH=Bisoprolol_icsr_sample_1068rows.xlsx
